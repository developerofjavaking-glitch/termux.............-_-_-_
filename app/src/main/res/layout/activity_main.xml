<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- Session bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#1E1E1E"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/appLogoIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="10dp"
            android:contentDescription="BoomAxe Logo"
            android:src="@drawable/ic_boomaxe_logo" />

        <TextView
            android:id="@+id/sessionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingLeft="8dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button android:id="@+id/btnPrev" style="@style/KeyButton" android:text="◀" />
        <Button android:id="@+id/btnNext" style="@style/KeyButton" android:text="▶" />
        <Button android:id="@+id/btnNew" style="@style/KeyButton" android:text="+" />
        <Button android:id="@+id/btnClose" style="@style/KeyButton" android:text="✕" />
    </LinearLayout>

    <!-- Bootstrap Installation Status Banner -->
    <LinearLayout
        android:id="@+id/bootstrapStatusLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#232731"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/bootstrapStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Installing BoomAxe bootstrap (required for pkg &amp; pip)..."
            android:textColor="#88C0D0"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/bootstrapProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0" />

        <Button
            android:id="@+id/btnRetryBootstrap"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:background="#3B4252"
            android:text="Retry Download"
            android:textColor="#ECEFF4"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <com.termux.view.TerminalView
        android:id="@+id/terminalView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:importantForAutofill="no" />

    <!-- Extra keys -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#1E1E1E"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <Button android:id="@+id/keyEsc" style="@style/KeyButton" android:text="ESC" />
            <Button android:id="@+id/keyTab" style="@style/KeyButton" android:text="TAB" />
            <Button android:id="@+id/keyCtrl" style="@style/KeyButton" android:text="CTRL" />
            <Button android:id="@+id/keyAlt" style="@style/KeyButton" android:text="ALT" />
            <Button android:id="@+id/keyLeft" style="@style/KeyButton" android:text="←" />
            <Button android:id="@+id/keyUp" style="@style/KeyButton" android:text="↑" />
            <Button android:id="@+id/keyDown" style="@style/KeyButton" android:text="↓" />
            <Button android:id="@+id/keyRight" style="@style/KeyButton" android:text="→" />
            <Button android:id="@+id/keyDash" style="@style/KeyButton" android:text="-" />
            <Button android:id="@+id/keySlash" style="@style/KeyButton" android:text="/" />
            <Button android:id="@+id/keyPipe" style="@style/KeyButton" android:text="|" />
            <Button android:id="@+id/keyTilde" style="@style/KeyButton" android:text="~" />
            <Button android:id="@+id/keyHome" style="@style/KeyButton" android:text="HOME" />
            <Button android:id="@+id/keyEnd" style="@style/KeyButton" android:text="END" />
            <Button android:id="@+id/keyPgUp" style="@style/KeyButton" android:text="PGUP" />
            <Button android:id="@+id/keyPgDn" style="@style/KeyButton" android:text="PGDN" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
